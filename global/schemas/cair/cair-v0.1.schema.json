{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/aec/schema/cair/0.1.0",
  "title": "Canonical AEC Intermediate Representation snapshot",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "created_at", "project_id", "status", "objects", "relations"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["SUCCESS", "SUCCESS_WITH_WARNINGS", "PARTIAL", "FAILED", "REQUIRES_REVIEW"]},
    "metadata": {"type": "object"},
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "project_id", "type", "source", "geometry_ref", "bbox", "properties", "classification", "provenance", "version"],
        "properties": {
          "id": {"type": "string", "pattern": "^aec://"},
          "project_id": {"type": "string"},
          "type": {"type": "string"},
          "source": {
            "type": "object",
            "required": ["file", "format"],
            "properties": {
              "file": {"type": "string"},
              "format": {"type": "string"},
              "entity_id": {"type": ["string", "null"]},
              "layer": {"type": ["string", "null"]},
              "artifact_id": {"type": ["string", "null"]}
            }
          },
          "geometry_ref": {"type": ["string", "null"]},
          "bbox": {"type": "object"},
          "placement": {"type": ["object", "array"]},
          "properties": {"type": "object"},
          "classification": {"type": ["object", "null"]},
          "provenance": {"type": ["object", "null"]},
          "version": {"type": "object"}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "predicate", "object"],
        "properties": {
          "subject": {"type": "string"},
          "predicate": {"type": "string"},
          "object": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "provenance": {"type": "object"}
        }
      }
    }
  }
}
