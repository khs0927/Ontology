# Copy to .env next to docker-compose.yml and adjust. docker compose reads it automatically.
# Host folder for Postgres data, artifacts and snapshots (keep it on a local disk, not a synced Drive folder).
AEC_HOST_DATA_ROOT=D:/AECData
AEC_DB_PASSWORD=change-me
# API bearer token. Leave empty only for loopback-only experiments. scripts/ops/init-env.ps1 creates .env,
# generates this token (and AEC_DB_PASSWORD) and can copy it to power-cad-mcp's POWERCAD_ONTOLOGY_TOKEN.
# power-cad-mcp must send the same value: POWERCAD_ONTOLOGY_TOKEN = AEC_API_TOKEN. See docs/api-security.md.
AEC_API_TOKEN=
# Comma-separated browser origins allowed by CORS ('*' ignored). Empty = CORS off (same-origin dashboard works).
AEC_CORS_ORIGINS=
# Optional embedding endpoint (OpenAI-compatible POST <url>/v1/embeddings, 1024-d). Empty means offline:
# deterministic hash vectors are stored (not semantic). Vectors are never relabelled to the hash model.
# If a configured endpoint fails during ingest, the objects/graph are still stored, the job succeeds with
# result.embeddings_pending=true, and `python -m aec_intelligence.operational.cli reembed` fills them later.
# Set AEC_EMBEDDING_STRICT=1 to fail the job instead (old behaviour).
# Options: run-pipeline.ps1 -Embeddings (compose TEI bge-m3 on :58080), or Ollama on the host:
#   containers:   AEC_EMBEDDING_URL=http://host.docker.internal:11434
#   host workers: AEC_EMBEDDING_URL=http://127.0.0.1:11434
AEC_EMBEDDING_URL=
# Model name sent to the endpoint and stored with each vector: BAAI/bge-m3 (compose TEI) | bge-m3 (Ollama)
#AEC_EMBEDDING_MODEL=BAAI/bge-m3
AEC_EMBEDDING_STRICT=0

# Host-side pipeline (scripts/ops/*.ps1, python CLI on the PC)
# Use 127.0.0.1, not localhost: libpq tries ::1 first and Docker Desktop on Windows black-holes it, so
# every connection waited the full connect timeout (10 s) before falling back to IPv4.
AEC_DATABASE_URL=postgresql://aec:change-me@127.0.0.1:55432/aec
AEC_DATA_ROOT=D:\AECData
# ';'-separated; must contain the census -Root (e.g. the Drive root).
AEC_IMPORT_ROOTS=G:\내 드라이브;D:\AECData\imports
# DWG -> DXF: auto (ODA, else LibreDWG dwg2dxf) | oda | libredwg
AEC_DWG_CONVERTER=auto
AEC_ODA_EXECUTABLE=C:\Program Files\ODA\ODAFileConverter 27.1.0\ODAFileConverter.exe
# Empty = dwg2dxf on PATH
AEC_LIBREDWG_EXECUTABLE=
# ODA conversion timeout per file (seconds). Each job's DWG is staged alone so ODA converts one file.
AEC_ODA_TIMEOUT_SECONDS=900
# Content-addressed DWG->DXF cache (<sha[:2]>/<sha>.<converter>.dxf). Default: <AEC_DATA_ROOT>/dxf-cache.
# Pre-fill it on the host with: python -m aec_intelligence.operational.cli convert-dwg --census <census.jsonl>
# Containers read the same folder through the D:/AECData mount, so they never need ODA themselves.
AEC_DXF_CACHE_DIR=
# Worker SQL/AGE projection timeout for large drawings (seconds). Interactive DB sessions stay at 30s.
AEC_INGEST_STATEMENT_TIMEOUT_SECONDS=300
# Interactive session limits (seconds)
AEC_DB_CONNECT_TIMEOUT_SECONDS=10
AEC_DB_STATEMENT_TIMEOUT_SECONDS=30
# Job lease (seconds, min 15; renewed by a heartbeat) and attempts before a job is FAILED
AEC_LEASE_SECONDS=300
AEC_MAX_ATTEMPTS=3

# OCR for PDF pages without a text layer and for image files (pip install -e ".[ocr]").
# auto = RapidOCR (Korean PP-OCRv5, ONNX/CPU), then PaddleOCR; off disables OCR.
#AEC_OCR_ENGINE=auto
#AEC_OCR_MODEL_DIR=D:\AECData\ocr-models
#AEC_OCR_THREADS=2
#AEC_OCR_MAX_SIDE=4096

# Interactive priority / fast refusal / English queries (docs/OPERATIONS.ko.md section 8)
#AEC_INTERACTIVE_YIELD_SECONDS=15
#AEC_INTERACTIVE_MAX_WAIT_SECONDS=120
#AEC_REEMBED_HOURS=22-7
#AEC_ASK_SEMANTIC_TIMEOUT_MS=8000
#AEC_ASK_GATE_TIMEOUT_MS=1200
#AEC_QUERY_EXPANSION=glossary
#AEC_QUERY_TRANSLATION_CACHE=
