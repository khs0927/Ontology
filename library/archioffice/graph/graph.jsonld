  {
   "@id": "ARCHIOFFICE:setting:roomname",
   "@type": "ConfigSetting",
   "name": "RoomName",
   "project_key": "ARCHIOFFICE",
   "props": {
    "source_file": "RoomName.txt",
    "section_count": 0,
    "item_count": 24,
    "encoding": "cp949",
    "content_sha256": "feebcbbdac6fb70a183e0922adf07a20607624c8b4b6048f445ef66ee9ddba8a",
    "content_excerpt": "거  실\n계 단 실\n근린생활시설\n기 계 실\n기계식주차장\n발 코 니\n보 육 실\n사 무 실\n식  당\n안  방\n엘리베이터홀\n예 비 실\n장애인화장실\n전 기 실\n주  방\n주방/식당\n지하주차장\n창  고\n체력단련실\n침  실\n테 라 스\n화 장 실\n화장실(남)\n화장실(여)"
   }
  }
 ]
}